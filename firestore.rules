rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // O login Google do projeto já controla os usuários autorizados.
    // A página também exige uma sessão fiscal ou gerencial antes de acessar os dados.
    match /divida_ativa_mei/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /divida_ativa_mei_historico/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /divida_ativa_mei_arquivos/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
